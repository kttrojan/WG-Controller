<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="com.wireguard.android.permission.CONTROL_TUNNELS" />

    <application
        android:label="WG Controller"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <receiver
            android:name=".MacroReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="pl.example.wgcontroller.DOWN"/>
                <action android:name="pl.example.wgcontroller.UP"/>
            </intent-filter>

        </receiver>

    </application>
</manifest>
